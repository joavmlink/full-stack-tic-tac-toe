# Copy to backend/.env for local development. Never commit backend/.env.

# API port for local development.
PORT=3000

# PostgreSQL connection string. Leave empty to use a local PGlite database (no setup needed).
# Production (Vercel) requires it: use the pooled Neon connection string, e.g.
# postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
DATABASE_URL=

# Local PGlite data directory (used when DATABASE_URL is empty). "memory://" = ephemeral.
PGLITE_DIR=./data/pglite

# Frontend origin(s) allowed by CORS in development (comma separated).
FRONTEND_URL=http://localhost:5173

# Max match creations/updates per client IP per minute (shared by every instance).
RATE_LIMIT_WRITES_PER_MINUTE=30

# Max reads per client IP per minute (counted per server instance).
RATE_LIMIT_READS_PER_MINUTE=120
