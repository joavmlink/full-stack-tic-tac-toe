# Always save exact versions (no ^ or ~) on `npm install <package>`.
save-exact=true
# Fail the install if the Node/npm version does not satisfy "engines" in package.json.
engine-strict=true
# Only install versions published at least 14 days ago (supply-chain protection: malicious or broken
# releases are usually caught and pulled within days). `npm ci` installs the lockfile as is.
min-release-age=14
